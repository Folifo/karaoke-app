# Copier en .env puis adapter. Lu automatiquement par docker compose.

POSTGRES_DB=karaoke
POSTGRES_USER=karaoke
POSTGRES_PASSWORD=karaoke

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Secret HMAC des JWT : au moins 32 caractères. À changer hors développement.
JWT_SECRET=dev-only-secret-change-me-please-0123456789

# URL de MinIO telle que vue par le téléphone (sert à signer les URLs).
# Émulateur Android : http://10.0.2.2:9000 — appareil physique : http://<IP du poste>:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
